{
  "name": "portfolio_zyekim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -r https://github.com/zyekim/zyekim.github.io.git -b main"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "eslint": "^9.25.0",
    "eslint-plugin-vue": "^10.0.0",
    "gh-pages": "^6.3.0",
    "prettier": "^3.5.0",
    "sass": "^1.89.2",
    "typescript": "~5.8.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
